# OFF until owner-approved WhatsApp setup. No AI provider or API key is needed.
BOT_ENABLED=false
BOT_NAME=Nandhana
# Exact allowed direct-chat JIDs (digits@s.whatsapp.net or digits@lid); empty permits nobody.
ALLOWED_CHATS=
AUTH_DIR=./auth
MAX_INPUT_CHARS=2000
MAX_CHATS=100
CHAT_TTL_MS=1800000
RATE_LIMIT_PER_MINUTE=6
DOWNLOAD_TIMEOUT_MS=20000
MAX_MEDIA_BYTES=12582912

# Web owner screen; required for npm run web / Docker. Never commit actual values.
PORT=8000
PUBLIC_ORIGIN=
WEB_OWNER_USERNAME=
WEB_OWNER_PASSWORD=
# PUBLIC_ORIGIN must be your exact https://SERVICE.koyeb.app origin, no path.
# Owner password: at least 24 chars, 3 character classes, 10 distinct chars.

# Optional encrypted PostgreSQL auth storage. File storage remains the default.
AUTH_STORE=file
SESSION_ID=nandhana-primary
DATABASE_URL=
DATABASE_URL_POOLED=
# Direct URL used ONLY by explicit npm run db:migrate; never auto-migrates.
DATABASE_URL_UNPOOLED=
# Exactly 64 hex characters (32 random bytes). Set privately in deployment secrets.
AUTH_ENCRYPTION_KEY=
