# OFF until owner-approved WhatsApp setup. No AI provider or API key is needed.
BOT_NAME=Nandhana
# Restricted default: exact direct-chat JIDs; required only when PUBLIC_ACCESS=false.
ALLOWED_CHATS=
# Explicitly opt into public one-to-one downloads; owner international digits required.
PUBLIC_ACCESS=false
# Replace privately with the confirmed owner number, digits only. Never commit the value.
OWNER_NUMBER=
AUTH_DIR=./auth
MAX_INPUT_CHARS=2000
MAX_CHATS=100
CHAT_TTL_MS=1800000
RATE_LIMIT_PER_MINUTE=6
DOWNLOAD_TIMEOUT_MS=20000
MAX_MEDIA_BYTES=12582912

# Web owner screen; required for npm run web / Docker. Never commit actual values.
PORT=8000
PUBLIC_ORIGIN=
WEB_OWNER_USERNAME=
WEB_OWNER_PASSWORD=
# PUBLIC_ORIGIN must be your exact https://SERVICE.koyeb.app origin, no path.
# Owner password: at least 24 chars, 3 character classes, 10 distinct chars.

# DATABASE_URL automatically selects encrypted PostgreSQL storage (recommended on Koyeb Free).
# One certificate-verified URL serves automatic schema setup and all runtime queries.
DATABASE_URL=
# Blank for first pairing; copy the displayed nonsecret ID here after saved success.
SESSION_ID=
# Exactly 64 hex characters (32 random bytes). Keep unchanged in deployment secrets.
AUTH_ENCRYPTION_KEY=
# Without DATABASE_URL, file storage is used for local setup (ephemeral on Koyeb).
# Optional local override only: AUTH_STORE=file
# Each server restart is idle. Start downloader explicitly from /owner.
