# OFF by default. Do not activate until session/privacy/provider setup is reviewed.
BOT_ENABLED=false
BOT_NAME=Nandhana
# Exact allowed direct-chat JIDs, comma separated. Empty permits nobody.
# Supports digits@s.whatsapp.net and digits@lid. Do not commit real values.
ALLOWED_CHATS=
# Set these from your chosen OpenAI-compatible provider documentation.
# Base URL must use HTTPS and end at the API version root (often /v1).
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Sessions are sensitive linked-device credentials. Never upload or commit auth/.
AUTH_DIR=./auth
MAX_INPUT_CHARS=2000
MAX_OUTPUT_CHARS=2000
HISTORY_TURNS=6
MAX_CHATS=100
CHAT_TTL_MS=1800000
RATE_LIMIT_PER_MINUTE=6
AI_TIMEOUT_MS=30000
